# VitePress / node
node_modules
.vitepress/dist
.vitepress/cache

# python
scripts/__pycache__/

# generated reference + rustdoc (docs/scripts/*)
/api
# `handl/` on disk is generated output only — scripts/gen_reference*.py
# writes `handl/reference/<repo>/`. All hand-written handl pages are
# vendored from the host repo's docs/site/ (see /vendored/ below).
# Pages serves the gh-pages branch; scripts/deploy-pages.sh drops a
# .nojekyll into dist so the Jekyll pass (which honours .gitignore and
# would drop these generated pages) is skipped.
/handl/

# the project worktree (ADR-0129)
/project/

# vendored product docs (scripts/vendor-docs.py) — sourced from each
# product repo's docs/site/, served at the site root via rewrites
/vendored/
